{
  "name": "grok-desktop-portable",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "main": "server.mjs",
  "description": "Grok Desktop Portable: the desktop.grok.me Work SPA and the Spanreed installers",
  "scripts": {
    "build": "pnpm --filter @grok-desktop-portable/web build && node scripts/prepare-public.mjs",
    "build:web": "pnpm --filter @grok-desktop-portable/web build && node scripts/prepare-public.mjs",
    "build:web:dist": "pnpm --filter @grok-desktop-portable/web build",
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "test:web": "pnpm --filter @grok-desktop-portable/web test",
    "test:public": "node scripts/prepare-public.test.mjs",
    "test:install": "sh scripts/install-resolve.test.sh",
    "typecheck:web": "pnpm --filter @grok-desktop-portable/web typecheck",
    "test": "pnpm test:web && pnpm test:public && pnpm test:install"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  }
}
