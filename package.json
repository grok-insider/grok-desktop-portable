{
  "name": "grok-desktop-portable",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "server.mjs",
  "description": "Grok Desktop Portable monorepo: local bridge host + Work SPA + landing site",
  "scripts": {
    "build": "pnpm --filter @grok-desktop-portable/web build && node scripts/prepare-public.mjs",
    "build:web": "pnpm --filter @grok-desktop-portable/web build && node scripts/prepare-public.mjs",
    "build:web:dist": "pnpm --filter @grok-desktop-portable/web build",
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "test:web": "pnpm --filter @grok-desktop-portable/web test",
    "test:public": "node scripts/prepare-public.test.mjs",
    "test:embed": "sh scripts/assert-spa-embedded.test.sh",
    "typecheck:web": "pnpm --filter @grok-desktop-portable/web typecheck",
    "build:bridge": "pnpm build:web:dist && cargo build -p grok-bridge --release",
    "test": "pnpm test:web && pnpm test:public && pnpm test:embed && cargo test -p grok-bridge"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  }
}
